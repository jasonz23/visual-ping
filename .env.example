# Copy to .env and fill in. Never commit .env.
VP_BASE_URL=http://54.214.7.161/
VP_USERNAME=your.username
VP_PASSWORD=your-basic-auth-password

# Optional tuning
VP_CONCURRENCY=3
VP_ARTIFACT_DIR=./artifacts
VP_OUT_DIR=./out
VP_MAX_PAGES=2000
VP_NAV_TIMEOUT_MS=30000
VP_IDLE_TIMEOUT_MS=8000
VP_LOG_LEVEL=info

# Optional upstream proxy for the whole crawl (documents + subresources).
# The site geo-gates one page on the real source IP, so header spoofing cannot
# reach it — only originating from the target region can. Point this at an exit
# node there. Supports http(s):// and socks5://, with optional credentials:
#   VP_PROXY=http://user:pass@de-exit.example.net:8080
# VP_PROXY=
